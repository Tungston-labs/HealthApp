
@base_url = http://127.0.0.1:8000/api/client/

POST http://127.0.0.1:8000/api/auth/login/
Content-Type: application/json

{
  "email_or_phno": "9876543210",
  "password": "Password@123"
}
### Client Registration
POST {{base_url}}register/
Content-Type: application/json

{
  "name": "John Doe",
  "phno": "9876543210",
  "email": "john@example.com",
  "dob": "1990-01-15",
  "gender": "male",
  "blood_group": "O+",
  "weight": "70.5",
  "height": "175.0",
  "wellness_goal": "weight loss",
  "address": "123 Street, City",
  "health_issues": "no",
  "password":"Password@123"
}
### List Clients
GET {{base_url}}client/
Authorization: Bearer <access_token>
### Retrieve Client Profile
GET {{base_url}}client/1/
Authorization: Bearer <access_token>
### Update Client Profile
PATCH {{base_url}}client/1/
Authorization: Bearer <access_token>
Content-Type: multipart/form-data

{
  "name": "John Updated",
  "weight": "72.0",
  "profile_pic": "@/path/to/new_image.jpg"
}
### Delete Client Profile
DELETE {{base_url}}client/1/
Authorization: Bearer <access_token>
