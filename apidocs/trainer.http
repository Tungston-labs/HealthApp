@base_url = http://127.0.0.1:8000/api/trainer/

###----------------------login/get access token and refresh token
POST http://127.0.0.1:8000/api/auth/login/
Content-Type: application/json

{
  "email_or_phno": "7011126542",
  "password": "Password@1234"
}

